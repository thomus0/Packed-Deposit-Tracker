{
  "name": "packed-deposit-tracker",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/db/migrate.js && node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "ts-node-dev --transpile-only src/db/migrate.ts",
    "test": "node --test --test-concurrency=1 --require ts-node/register/transpile-only --require ./src/__tests__/setup.ts \"src/__tests__/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@slack/web-api": "^7.17.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "stripe": "^22.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "ts-node": "^10.9.2"
  }
}
